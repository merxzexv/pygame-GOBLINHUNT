    <script type="application/javascript">
    globalThis.__canvas_resized = (self, ecw, ech) => {}

    (function() {
        const infobox = document.getElementById("infobox");
        const transfer = document.getElementById("transfer");
        if (infobox && transfer) {
            const obs = new MutationObserver(() => {
                if (infobox.style.display !== "none" && (infobox.innerText || "").includes("Click to Play")) {
                    transfer.style.display = "none";
                }
            });
            obs.observe(infobox, { attributes: true, attributeFilter: ["style"] });
        }
    })();

    async function custom_onload(debug_hidden) {
        document.getElementById("pyconsole").hidden = true;
        document.getElementById("system").hidden = true;
        document.getElementById("box").hidden = true;
    }
    function custom_prerun(){}
    function custom_postrun(){}
    function info_inline(data){ document.getElementById("info").innerHTML = data; }
    function frame_online(url) { window.frames["iframe"].location = url; }
    </script>
